# 统一换行符：本项目的脚本要跑在 Linux 上，
# 若仓库里存成 CRLF，部署时会报 $'\r': command not found。
* text=auto eol=lf

# 脚本与配置：强制 LF
*.sh      text eol=lf
*.py      text eol=lf
*.conf    text eol=lf
*.service text eol=lf
*.rules   text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.java    text eol=lf
*.xml     text eol=lf
*.md      text eol=lf
*.sql     text eol=lf
*.ts      text eol=lf
*.vue     text eol=lf
*.mjs     text eol=lf
*.html    text eol=lf
*.css     text eol=lf

# 二进制：不要做任何转换
*.jar    binary
*.zip    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.pdf    binary
