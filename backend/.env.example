# ============================================
# JDY Cloud Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Application port
SERVER_PORT=15060

# CORS allowed origins (comma separated)
# 同源部署（前端由本机 nginx 托管）可留空；前后端分离部署时填写前端地址。
CORS_ALLOWED_ORIGINS=

# ---- 站点身份（v1.48.0 起新增，必填）----
# 你的域名，不含 https:// 与结尾斜杠。用于分享链接生成、封禁页跳转白名单、
# CORS 内置白名单与攻击溯源报告署名。留空时相关位置回退为请求的 Host 头。
SITE_DOMAIN=
# 站点完整地址；留空则由 SITE_DOMAIN 推导为 https://{domain}
SITE_BASE_URL=
# 对外联系方式：留空则邮件模板中不显示对应行
SITE_CONTACT_EMAIL=
SITE_CONTACT_QQ=

# Database
DB_URL=jdbc:mysql://localhost:3306/jdy_cloud?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_EXPIRATION=86400000

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=100MB
MAX_REQUEST_SIZE=200MB

# Mail service (verification codes)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password

# Initial admin
# 首次启动时若库中还没有管理员，会按下面三项创建；已有管理员则不做任何改动。
# 下面是通用示例值，正式部署请换成你自己的用户名与强密码，并在首次登录后立即改密。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
ADMIN_EMAIL=admin@example.com

# Security
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=30
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60
RATE_LIMIT_AUTH_RPM=10
CODE_SEND_INTERVAL=60

# 管理员出口 IP 白名单（逗号分隔）：填写后该 IP 获得限流与封禁完全豁免。
# 家宽 IP 会变动，谨慎填写；留空时管理员凭 JWT 角色仍不会被硬封。
ADMIN_IP_WHITELIST=

# IronWall 蜜标账号：填「真实用户绝不可能提交」的账号名（逗号分隔），
# 攻击者一旦尝试登录这些账号即判为高置信攻击。留空则该防线停用。
ATTACK_GUARD_LOGIN_HONEYPOT_USERNAMES=

# IronWall 规则文件路径。规则与代码分离部署，可随时调整检测策略；缺失时启动会告警。
IRONWALL_RULES_FILE=./config/ironwall-rules.json

# IronWall 假端口陷阱：填你实际占用的端口（管理面板、改过的 SSH 等，逗号分隔），
# 生成的诱饵端口就会避开它们。真正开端口的是 decoy-port-manager 服务，
# 同一份清单也要写进 /etc/systemd/system/ironwall-decoy.service 的 Environment=。
IRONWALL_RESERVED_PORTS=

# IronWall v1.38.0: ban sync / aggregation / alerts
BAN_SYNC_ENABLED=true
BAN_SYNC_INTERVAL_MS=30000
AGG_UA_IP_THRESHOLD=8
AGG_TLS_IP_THRESHOLD=6
AGG_DEVICE_IP_THRESHOLD=4
AGG_WINDOW_MS=1800000
ALERTS_ENABLED=true
ALERTS_WEBHOOK_URL=
ALERTS_EMAIL_ENABLED=true

# IronWall v1.42.0: storage encryption / route code rotation / share link signature / mobile carrier fuse
# 存储主密钥：留空时自动生成到 STORAGE_ENCRYPTION_KEY_FILE，该文件必须备份，删除即历史加密文件不可读
IRONWALL_STORAGE_KEY=
STORAGE_ENCRYPTION_ENABLED=true
STORAGE_ENCRYPTION_KEY_FILE=./config/storage-master.key
API_CRYPTO_ROUTE_CODE_ROTATION_HOURS=24
API_CRYPTO_ROUTE_CODE_GRACE_PERIODS=1
SHARE_LINK_SECRET=
ATTACK_GUARD_MOBILE_CARRIER_ENABLED=true
ATTACK_GUARD_MOBILE_CARRIER_MAX_BLOCK_MINUTES=30

# Logging
LOG_LEVEL=INFO
SHOW_SQL=false
