#!/bin/bash
# ============================================================================
# 经典云网盘 · 启动脚本模板（IronWall v1.48.0）
#
# 用法：
# cp start.sh.example start.sh
# vi start.sh # 把下面所有 <<< 请填写 >>> 换成你自己的值
# chmod +x start.sh
# ./start.sh
#
# 说明：
# start.sh 已在 .gitignore 中，你的密钥不会被提交出去。
# 带 ★ 的是必填项，留空会直接启动失败并打印缺哪一项——这是故意的，
# 避免站点带着半套配置上线。
# 本脚本必须保持 LF 换行。若从 Windows 上传，先执行：
# sed -i 's/\r$//' start.sh
# ============================================================================

set -u

# ---------------------------- ★ 数据库（必填） ----------------------------
export DB_URL="jdbc:mysql://127.0.0.1:3306/jdy_cloud?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=UTF-8"
export DB_USERNAME="<<< 请填写：数据库用户名 >>>"
export DB_PASSWORD="<<< 请填写：数据库密码 >>>"

# ---------------------------- ★ 签名密钥（必填） ----------------------------
# 生成方式：openssl rand -hex 32
# 切勿使用示例值，也切勿与任何人共享；更换后所有已登录用户会重新登录。
export JWT_SECRET="<<< 请填写：64 位十六进制随机串 >>>"

# ---------------------------- ★ 站点身份（必填） ----------------------------
# 你的域名，不含 https:// 与结尾斜杠。用于分享链接、封禁页跳转与 CORS 白名单。
export SITE_DOMAIN="<<< 请填写：你的域名，例如 drive.example.com >>>"

# ---------------------------- ★ 管理员账号（必填） ----------------------------
# 首次启动时，若库中还没有管理员，会按下面三项自动创建；已有管理员则不做任何改动。
# 下面是通用示例值，能直接跑起来；正式对外服务前请务必换成你自己的用户名与强密码，
# 并在首次登录后立即修改密码。ADMIN_EMAIL 同时用于接收申诉与反馈通知。
export ADMIN_USERNAME="admin"
export ADMIN_PASSWORD="Admin@123456"
export ADMIN_EMAIL="admin@example.com"

# ---------------------------- 邮件通知（可选） ----------------------------
# 不填则注册验证码、找回密码等邮件功能不可用（其余功能正常）。
export MAIL_HOST="smtp.qq.com"
export MAIL_PORT=587
export MAIL_USERNAME=""
export MAIL_PASSWORD=""
export MAIL_FROM=""
export MAIL_PERSONAL=""

# ---------------------------- 对外联系方式（可选） ----------------------------
export SITE_BASE_URL=""
export SITE_CONTACT_EMAIL=""
export SITE_CONTACT_QQ=""

# ---------------------------- 运行参数（按需调整） ----------------------------
export SERVER_PORT=15060
export JWT_EXPIRATION=86400000
export UPLOAD_DIR="./uploads"
export MAX_FILE_SIZE="850MB"
export MAX_REQUEST_SIZE="900MB"
export LOG_LEVEL="INFO"
export SHOW_SQL=false

# CORS：同源部署（前端由本机 nginx 托管）无需填写，留空即可。
# 前端与后端分离部署时，在此列出前端地址，逗号分隔。
export CORS_ALLOWED_ORIGINS=""

# 运维出口 IP 白名单：填写后该 IP 获得限流与封禁完全豁免。家宽 IP 会变，谨慎填写。
export ADMIN_IP_WHITELIST=""

# IronWall 蜜标账号：填入「真实用户绝不可能提交」的账号名（逗号分隔）。
# 攻击者一旦尝试登录这些账号即被判定为高置信攻击。留空则该防线停用。
export ATTACK_GUARD_LOGIN_HONEYPOT_USERNAMES=""

# IronWall 规则文件：与代码分离部署，可随时调整检测策略。
export IRONWALL_RULES_FILE="./config/ironwall-rules.json"

# IronWall 假端口陷阱：填你实际占用的端口（管理面板、改过的 SSH 等，逗号分隔），
# 生成的诱饵端口就会避开它们，不与真实业务撞车。
# 注意：真正开端口的是 decoy-port-manager 服务，同一份端口清单也要写进
# /etc/systemd/system/ironwall-decoy.service 的 Environment="IRONWALL_RESERVED_PORTS=..."。
export IRONWALL_RESERVED_PORTS=""

# ============================================================================

APP_DIR="$(cd "$(dirname "$0")" && pwd)"
LOG_DIR="$APP_DIR/logs"
mkdir -p "$LOG_DIR"

mark() {
  local msg="[$(date '+%F %T')] $1"
  echo "$msg"
  echo "$msg" >> "$LOG_DIR/app.log"
}

# ---------------------------- 启动前置校验 ----------------------------
# 缺配置就让站点起不来，总好过带着半套配置对外服务。
MISSING=""
require() {
  local name="$1" value="$2"
  # 纯 bash 判断，不依赖 grep 等外部命令（面板环境 PATH 可能被裁剪）
  case "$value" in
    ""|*"请填写"*) MISSING="$MISSING\n  - $name" ;;
  esac
}
require "DB_USERNAME"  "$DB_USERNAME"
require "DB_PASSWORD"  "$DB_PASSWORD"
require "JWT_SECRET"   "$JWT_SECRET"
require "SITE_DOMAIN"  "$SITE_DOMAIN"
require "ADMIN_USERNAME" "$ADMIN_USERNAME"
require "ADMIN_PASSWORD" "$ADMIN_PASSWORD"
require "ADMIN_EMAIL"  "$ADMIN_EMAIL"

if [ -n "$MISSING" ]; then
  echo "[配置缺失] 以下必填项尚未填写，已拒绝启动："
  printf '%b\n' "$MISSING"
  echo ""
  echo "请编辑 $APP_DIR/start.sh 补齐后重试。"
  exit 1
fi

# JWT_SECRET 强度校验：过短的密钥可被暴力破解，直接拒绝。
if [ "${#JWT_SECRET}" -lt 32 ]; then
  echo "[配置错误] JWT_SECRET 长度不足 32 位，请用 openssl rand -hex 32 重新生成。"
  exit 1
fi

if [ ! -f "$IRONWALL_RULES_FILE" ]; then
  # 缺失时引擎会退化为「仅放行、不检测」，站点仍可正常使用，
  # 因此这里只告警不阻断——想先跑起来再补规则的人不应该被挡在门外。
  echo "[提醒] IronWall 规则文件不存在：$IRONWALL_RULES_FILE"
  echo "       基于规则的检测族将全部停用（站点功能不受影响）。"
  echo "       复制默认规则集开始：cp config/ironwall-rules.sample.json \"$IRONWALL_RULES_FILE\""
  echo "       随后按自己的业务补全条目即可。"
fi

# ---------------------------- Java 定位 ----------------------------
JAVA_BIN=""
for c in "/www/server/java/jdk-21.0.2/bin/java" "/www/server/java/bin/java" "$(command -v java 2>/dev/null)"; do
  [ -n "$c" ] && [ -x "$c" ] && JAVA_BIN="$c" && break
done
if [ -z "$JAVA_BIN" ]; then
  mark "未找到可用 Java，请安装 JDK 21 或修改本脚本中的 Java 路径"
  exit 1
fi

# ---------------------------- 端口占用保护 ----------------------------
if ss -ltn 2>/dev/null | grep -q ":$SERVER_PORT "; then
  RUNNING_PID=$(ss -ltnp 2>/dev/null | grep ":$SERVER_PORT " | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2)
  [ -z "$RUNNING_PID" ] && RUNNING_PID=$(pgrep -f 'jdy-cloud\.jar' | head -1)
  mark "$SERVER_PORT 已被占用，未重复启动（运行中 pid=$RUNNING_PID；如需强制重启：pkill -f jdy-cloud.jar 后再执行本脚本）"
  exit 0
fi

cd "$APP_DIR" || { mark "目录不存在: $APP_DIR"; exit 1; }

# 启动自检期间挂维护标识，nginx 配合展示维护页，杜绝重启窗口被探测
touch "$LOG_DIR/maintenance.flag"

mark "启动 jdy-cloud.jar（Java: $JAVA_BIN）"
nohup "$JAVA_BIN" -Xmx1024M -Xms256M -jar "$APP_DIR/jdy-cloud.jar" >> "$LOG_DIR/app.log" 2>&1 &
PID=$!
disown "$PID" 2>/dev/null || true
mark "已拉起进程 PID=$PID，开始健康自检（最长 30 秒）"

for i in $(seq 1 30); do
  sleep 1
  if curl -fsS -m 3 -o /dev/null "http://127.0.0.1:$SERVER_PORT/api/files/ping" 2>/dev/null; then
    rm -f "$LOG_DIR/maintenance.flag"
    mark "经典云网盘启动成功（pid=$PID）"
    exit 0
  fi
done
rm -f "$LOG_DIR/maintenance.flag"
mark "30 秒内未通过健康检查，进程可能启动失败，请查看 logs/app.log 尾部"
exit 1
