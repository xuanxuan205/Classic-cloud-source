{
  "_comment": "IronWall 默认规则文件。\n\n包含通用检测规则，覆盖 OWASP 常见攻击面与公开扫描器特征。\n如需更严格的防护，可复制本文件为 ironwall-rules.json 并按需增补条目，\n路径通过 .env 的 IRONWALL_RULES_FILE 指定。\n启动日志会列出尚未配置的检测族，便于按需补充。",
  "version": "v1.48.0",
  "patterns": {
    "sqli": "(?i)(\\bunion\\s+(all\\s+)?select\\b|\\bsleep\\s*\\(|\\bpg_sleep\\s*\\(|\\bbenchmark\\s*\\(|\\bwaitfor\\s+delay\\b|information_schema|/\\*!|--\\s|;\\s*(drop|alter|truncate|insert|delete|update|select|union|show)\\b|\\bor\\s+['\"]?1['\"]?\\s*=\\s*['\"]?1\\b|\\band\\s+['\"]?1['\"]?\\s*=\\s*['\"]?1\\b|\\bor\\s+['\"][^'\"]{0,8}['\"]\\s*=\\s*['\"][^'\"]{0,8}['\"]\\b|concat\\s*\\(|group_concat\\s*\\(|load_file\\s*\\()",
    "xss": "(?i)(<\\s*script|</\\s*script|<\\s*img\\s|<\\s*svg\\b|</\\s*svg|<\\s*iframe|javascript\\s*:|vbscript\\s*:|on\\w+\\s*=|onload\\s*=|onerror\\s*=|data\\s*:\\s*text/html)",
    "traversal": "(\\.\\./|\\.\\.\\\\|%2e%2e|%252e%252e|%c0%ae|%uff0e%uff0e|%5c\\.\\.|/etc/passwd|/windows/win\\.ini|boot\\.ini\\b|\\bwin\\.ini\\b)",
    "cmd": "(?i)(;\\s*(rm|cat|sh|bash|nc|wget|curl|id|whoami|ls|uname)\\b|\\|\\s*(cat|bash|sh|id|whoami|uname)\\b|`\\s*(id|ls|cat|whoami|uname)\\b|cmd\\.exe|powershell(\\.exe)?|/bin/(bash|sh)|eval\\s*\\(|base64_decode\\s*\\()",
    "ssrf": "(?i)(file://|gopher://|dict://|ftp://(127\\.0\\.0\\.1|localhost)|http://(127\\.0\\.0\\.1|localhost|169\\.254\\.169\\.254))",
    "suspiciousPath": "(?i)(;[^/\\s]*\\.(js|css|html|htm|php|jsp|asp|aspx)(\\?|$)|(\\.php|\\.jsp|\\.asp|\\.aspx)(;|%00)|\\.(jpg|png|gif|svg)\\.(php|jsp|asp|aspx)(\\?|$))",
    "crawlerUa": "(?i)(curl/|wget/|python-requests|python-urllib|scrapy|aiohttp|httpx|go-http-client|apache-httpclient|okhttp/|java/[0-9._]+|headlesschrome|phantomjs|zgrab|node-fetch|axios/)",
    "toolUa": "(?i)(sqlmap|nikto|nmap|acunetix|nessus|burpsuite|burp suite|masscan|hydra|dirbuster|gobuster|openvas|vega|arachni|w3af|zaproxy|havij|fimap)"
  },
