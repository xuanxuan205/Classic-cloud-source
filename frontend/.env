# ============================================================
# 经典云网盘 · 前端默认配置（可提交的默认值）
#
# 想改成自己的站点？把你的配置写进 .env.local（已被 gitignore），
# 它会覆盖本文件，且不会影响仓库里的默认值。
# 各字段含义见 .env.example。
# ============================================================

# 站点全称：浏览器标题、页脚、登录页等处显示
VITE_SITE_NAME=经典云网盘

# 站点简称：设备指纹盐值等内部标识使用
VITE_SITE_SHORT_NAME=经典云

# 出品方署名：页脚显示。留空则不显示署名区块
VITE_STUDIO_NAME=

# 后端地址：仅 `npm run dev` 本地代理使用；生产由 nginx 反代 /api，无需配置
VITE_API_BASE_URL=http://localhost:15060

# 以下留空即使用中性默认值或隐藏对应入口，按需填写
VITE_SITE_DOMAIN=
VITE_SITE_URL=
VITE_CONTACT_EMAIL=
VITE_CONTACT_QQ_URL=
VITE_RECOMMEND_URL=
VITE_RECOMMEND_TITLE=
VITE_RECOMMEND_DESC=
