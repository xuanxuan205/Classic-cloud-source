# ============================================================
# 经典云网盘 · 前端配置模板
#
# 用法：
#   cp .env.example .env.local     # .env.local 已被 gitignore，不会提交
#   vi .env.local                  # 填写你自己的信息
#   npm run build
#
# .env.local 会覆盖仓库默认的 .env。
# ============================================================

# ---- 站点身份 ----
# 站点全称：浏览器标题、页脚、登录页、法律条款等处显示
VITE_SITE_NAME=我的网盘

# 站点简称：用于设备指纹盐值等内部标识，建议 2-6 个字
VITE_SITE_SHORT_NAME=我的云

# 出品方署名：显示在首页/关于/联系等页面页脚。留空则不显示署名区块
VITE_STUDIO_NAME=

# 你的域名，不含 https:// 与结尾斜杠
VITE_SITE_DOMAIN=drive.example.com

# 站点完整地址；留空则由 VITE_SITE_DOMAIN 推导为 https://{domain}
VITE_SITE_URL=

# ---- 联系方式 ----
# 对外联系邮箱：出现在「联系我们」「关于我们」「隐私政策」等页面
VITE_CONTACT_EMAIL=support@example.com

# 官方 QQ 加好友链接（如 https://qm.qq.com/q/xxxxxxxx）
# 留空则隐藏联系页与帮助中心的 QQ 入口
VITE_CONTACT_QQ_URL=

# ---- 首页友情推荐卡片（可放你自己的服务器/服务推广链接）----
# 留空则整个推荐区块不渲染
VITE_RECOMMEND_URL=
VITE_RECOMMEND_TITLE=
VITE_RECOMMEND_DESC=

# ---- 开发环境 ----
# 后端地址：仅 `npm run dev` 的本地代理使用；生产由 nginx 反代 /api，无需配置
VITE_API_BASE_URL=http://localhost:15060
